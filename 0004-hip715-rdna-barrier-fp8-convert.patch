+/// f8_e5m2x2 -> f16x2.
+template <>
+MSCCLPP_DEVICE_INLINE f16x2 to<f16x2, f8_e5m2x2>(const f8_e5m2x2& v) {
+#if defined(MSCCLPP_DEVICE_HIP) && defined(__gfx942__)
+  auto f = __builtin_amdgcn_cvt_pk_f32_bf8(v.storage.__x, 0);
+  f16x2 result;
+  result.data[0] = __float2half(f[0]);
+  result.data[1] = __float2half(f[1]);
+  return result;
+#else
+  f16x2 result;
+  result.data[0] = __float2half(mscclpp_fp8e5_to_f32(v.data[0]));
+  result.data[1] = __float2half(mscclpp_fp8e5_to_f32(v.data[1]));
+  return result;
+#endif
+}
+
+/// f16x2 -> f8_e5m2x2.
+template <>
+MSCCLPP_DEVICE_INLINE f8_e5m2x2 to<f8_e5m2x2, f16x2>(const f16x2& v) {
+#if defined(MSCCLPP_DEVICE_HIP) && defined(__gfx942__)
+  float f0 = __half2float(v.data[0]);
+  float f1 = __half2float(v.data[1]);
+  uint32_t packed = __builtin_amdgcn_cvt_pk_bf8_f32(f0, f1, 0, false);
+  return bit_cast<f8_e5m2x2>(static_cast<__hip_fp8x2_storage_t>(packed));
+#else
+  f8_e5m2x2 result;
+  result.data[0] = mscclpp_f32_to_fp8e5(__half2float(v.data[0]));
+  result.data[1] = mscclpp_f32_to_fp8e5(__half2float(v.data[1]));
+  return result;
+#endif
+}
 
 #endif  // defined(__FP8_TYPES_EXIST__)
 
