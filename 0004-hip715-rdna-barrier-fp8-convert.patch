+template <typename FromE>
+MSCCLPP_DEVICE_INLINE float mscclpp_as_f32(FromE v) {
+  if constexpr (std::is_same_v<FromE, float>) {
+    return v;
+  } else if constexpr (std::is_same_v<FromE, __half>) {
+    return __half2float(v);
+  } else if constexpr (std::is_same_v<FromE, __fp8_e4m3>) {
+    return mscclpp_fp8e4_to_f32(v);
+  } else if constexpr (std::is_same_v<FromE, __fp8_e5m2>) {
+    return mscclpp_fp8e5_to_f32(v);
+  } else {
+    return static_cast<float>(v);
+  }
+}
