HIP 7.15 remaining RDNA fat-binary compile fixes.

gfx1200/gfx1201 dropped s_barrier. OCP default constructors and
half/fp8 conversions are __host__-only on gfx942, so unions that
contain those types and the generic to<> static_cast fail there.

--- a/include/mscclpp/gpu.hpp	2026-07-22 02:04:20.000000000 +0200
+++ b/include/mscclpp/gpu.hpp	2026-09-07 22:15:25.856081663 +0200
@@ -150,7 +150,10 @@
 #endif  // defined(MSCCLPP_DEVICE_HIP)
 
 // GPU sync threads
-#if defined(MSCCLPP_DEVICE_HIP)
+// gfx1200/gfx1201 (RDNA4) dropped s_barrier; HIP __syncthreads() emits
+// s_barrier_signal/wait there and keeps the CDNA waitcnt+s_barrier form
+// on gfx9/gfx11.
+#if defined(MSCCLPP_DEVICE_HIP) && !defined(__gfx1200__) && !defined(__gfx1201__)
 #define __syncshm() asm volatile("s_waitcnt lgkmcnt(0) \n s_barrier");
 #else
 #define __syncshm() __syncthreads();
